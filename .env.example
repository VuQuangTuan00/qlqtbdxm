# Môi trường chạy ứng dụng
NODE_ENV=development

# Đường dẫn cơ sở dữ liệu (để trống để dùng mặc định: userData/qlqtbdxm.db)
DB_PATH=

# Cấp độ log: error | warn | info | debug
LOG_LEVEL=info

# Phiên đăng nhập tự động đăng xuất sau X phút (0 = không tự đăng xuất)
SESSION_TIMEOUT_MINUTES=480

# Khóa bí mật cho phiên (thay bằng chuỗi ngẫu nhiên trong production)
SESSION_SECRET=change-me-in-production-use-random-string

# Số vòng hash bcrypt (10-12 cho production)
BCRYPT_ROUNDS=10
