  "description": "Hệ thống quản lý bảo dưỡng xe máy quân đội",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect=5858",
    "test": "electron tests/run-tests.js",
    "test:syntax": "node scripts/check-syntax.js",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
