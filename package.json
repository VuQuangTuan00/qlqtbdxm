{
  "name": "qlqtbdxm",
  "version": "1.0.0",
  "description": "Hệ thống quản lý bảo dưỡng xe máy quân đội",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect=5858",
    "build": "npm run clean && electron-builder --win",
    "seed": "node scripts/seed.js",
    "reset-db": "node scripts/reset-db.js",
    "clean": "rimraf dist build"
  },
  "author": "Bộ Tư lệnh Xe Máy",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.6.1",
    "electron-log": "^5.1.2",
    "mssql": "^11.0.2",
    "tedious": "^19.2.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "rimraf": "^5.0.5"
  },
  "build": {
    "appId": "vn.military.qlqtbdxm",
    "productName": "QLQT Bảo Dưỡng XM",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QLQT Bảo Dưỡng XM"
    }
  }
}
