{
  "name": "qlqtbdxm",
  "version": "1.0.0",
  "description": "Hệ thống quản lý bảo dưỡng xe máy quân đội",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect=5858",
    "build": "electron-builder",
    "seed": "node scripts/seed.js",
    "reset-db": "node scripts/reset-db.js"
  },
  "author": "Bộ Tư lệnh Xe Máy",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.3",
    "dotenv": "^16.4.5",
    "electron-log": "^5.1.2"
  },
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "vn.military.qlqtbdxm",
    "productName": "QLQT Bảo Dưỡng XM",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    },
    "win": {
      "target": "nsis"
    }
  }
}
