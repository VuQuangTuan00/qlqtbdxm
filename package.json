    "electron-log": "^5.1.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "mssql": "^11.0.1",
    "rimraf": "^5.0.5"
  }
