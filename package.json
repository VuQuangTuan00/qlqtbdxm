{
  "name": "qlqtbdxm",
  "version": "1.0.0",
  "description": "Hệ thống quản lý bảo dưỡng xe máy quân đội",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect=5858",
    "build": "npm run clean && electron-builder --win",
    "seed": "node scripts/seed.js",
    "reset-db": "node scripts/reset-db.js",
    "export-demo": "node scripts/export-demo-db.js",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "clean": "rimraf dist build"
  },
  "author": "Bộ Tư lệnh Xe Máy",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.6.0",
    "dotenv": "^16.6.1",
    "electron-log": "^5.1.2",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "rimraf": "^5.0.5"
  },
  "build": {
    "appId": "vn.military.qlqtbdxm",
    "productName": "QLQT Bảo Dưỡng XM",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "scripts/seed-sqlite-runtime.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "demo-assets/demo.db",
        "to":   "demo-assets/demo.db"
      },
      {
        "from": "demo-assets/vehicle-images",
        "to": "demo-assets/vehicle-images",
        "filter": ["**/*.jpg", "**/*.jpeg", "**/*.png", "**/*.webp"]
      },
      {
        "from": "demo-assets/maintenance-files",
        "to": "demo-assets/maintenance-files",
        "filter": ["**/*.pdf"]
      }
    ],
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    },
    "win": {
     
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
     
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QLQT Bảo Dưỡng XM"
    }
  }
}
