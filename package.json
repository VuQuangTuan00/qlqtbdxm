{
  "name": "Quy Trình Công Nghệ - Định Mức Kinh Tế Kỹ Thuật",
  "version": "1.0.0",
  "description": "Hệ thống quản lý Quy Trình Công Nghệ - Định Mức Kinh Tế Kỹ Thuật",
  "main": "main/index.js",
  "scripts": {
    "test": "node tests/run-tests.js all",
    "test:unit": "node tests/run-tests.js unit",
    "test:integration": "node tests/run-tests.js integration",
    "test:security": "node tests/run-tests.js security",
    "test:e2e": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File tests/run-e2e.ps1",
    "start": "electron .",
    "dev": "electron . --inspect=5858",
    "build": "npm run clean && electron-builder --win",
    "seed": "node scripts/seed.js",
    "reset-db": "node scripts/reset-db.js",
    "clean": "rimraf dist"
  },
  "author": "Lữ Đoàn Công Binh 279",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.6.1",
    "electron-log": "^5.1.2",
    "mssql": "^11.0.1",
    "tedious": "^19.2.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "rimraf": "^5.0.5"
  },
  "build": {
    "appId": "vn.military.qlqtbdxm",
    "productName": "Quy Trình Công Nghệ - Định Mức Kinh Tế Kỹ Thuật",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quy Trình Công Nghệ - Định Mức Kinh Tế Kỹ Thuật"
    }
  }
}
